{
  "layer": "top",
  "position": "top",
  "height": 28,

  "modules-left": ["hyprland/workspaces"],

  "modules-right": [
    "temperature",
    "memory",
    "battery",
    "pulseaudio",
    "backlight",
    "network",
    "clock#date",
    "clock#time"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true
  },

  "hyprland/window": {
    "format": "{title}"
  },

  "temperature": {
    "format": "CPU {temperatureC}°",
    "critical-threshold": 90
  },

  "memory": {
    "format": "RAM {used:0.1f}GB"
  },

  "battery": {
    "format": "POWER {capacity}%"
  },

  "pulseaudio": {
    "format": "VOLUME {volume}%"
  },

  "backlight": {
    "format": "BRIGHTNESS {percent}%"
  },
  "network": {
    "format-wifi": "WIFI",
    "format-ethernet": "LAN",
    "format-disconnected": "OFF"
  },

  "clock#date": {
    "format": "{:%y%m%d}"
  },

  "clock#time": {
    "format": "{:%H:%M}"
  }
}
